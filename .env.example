# apps/web (frontend) config only. Server/API secrets live in apps/api/.env
# - see apps/api/.env.example and docs/ops.md.
# In production (Vercel) these are set in the Vercel project's Environment
# Variables settings, not read from this file.
#
# Only `VITE_`-prefixed keys reach the browser bundle (vite.config.ts inlines
# them via `loadEnv`). Anything else here is read by repo scripts only.

# --- Required ---

# Everlumen Supabase project (publishable key - safe in client code, RLS applies).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Standalone @everlumen/api deployment (Railway) this web app calls. Leave unset
# for local dev against the old colocated-Worker routes; set once deployed.
# Production: https://api.everlumen.co
VITE_API_BASE_URL=

# --- Optional ---

# Set to 1 to withhold every price from the PUBLIC marketing pages: the plan
# shelf on /pricing, the "plans from" lines on the home/features/how-it-works/
# FAQ pages, and the signup page's meta description. The cards keep their tier
# names, seat counts and feature lists and read "Contact us" where the figure
# would be. Unset (the default) prices the site normally.
#
# The signed-in upgrade flow is deliberately NOT covered: its CTA opens Stripe
# checkout, so hiding the number there would make the payment page the first
# place a customer learns the cost. See HIDE_PUBLIC_PRICING in
# apps/web/src/lib/pricing.ts.
#
# Vite inlines this at build time, so changing it needs a redeploy, not just a
# restart. In production set it in the Vercel project's Environment Variables.
VITE_HIDE_PRICING=

# Google Maps browser key (HTTP-referrer restricted - safe to expose to the
# client). Unset = the map page and project map render without tiles.
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Storage's per-file upload limit, in MB, so the recorders can warn
# before a doomed upload instead of after. Mirror whatever the dashboard says -
# Storage -> Files -> Settings tab, "Global file size limit" (it is NOT under
# Project Settings). Unset assumes Supabase's own 50 MB default.
#
# Advisory only: a wrong value never blocks an upload, it only changes the
# warning copy, so it is safe to keep in sync by hand. Raised from the 50 MB
# default on 2026-08-12 to clear the ~314 MB worst case (20-minute Team video).
VITE_MAX_UPLOAD_MB=500

# Sign-in credentials for the Playwright smoke scripts under scripts/ (they
# parse this file directly - see scripts/login-debug.mjs). Not read by the app,
# and not needed unless you run those scripts. Use a throwaway account: these
# are a real login, so whatever you put here can read that account's projects.
email=
password=
