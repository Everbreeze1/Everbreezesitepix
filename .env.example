# apps/web (frontend) config only. Server/API secrets live in apps/api/.env
# — see apps/api/.env.example and docs/ops.md.
# In production (Vercel) these are set in the Vercel project's Environment
# Variables settings, not read from this file.
#
# Only `VITE_`-prefixed keys reach the browser bundle (vite.config.ts inlines
# them via `loadEnv`). Anything else here is read by repo scripts only.

# --- Required ---

# SitePix Supabase project (publishable key — safe in client code, RLS applies).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Standalone @sitepix/api deployment (Railway) this web app calls. Leave unset
# for local dev against the old colocated-Worker routes; set once deployed.
# Production: https://api.everbreezesitepix.com
VITE_API_BASE_URL=

# --- Optional ---

# Google Maps browser key (HTTP-referrer restricted — safe to expose to the
# client). Unset = the map page and project map render without tiles.
VITE_GOOGLE_MAPS_API_KEY=

# Sign-in credentials for the Playwright smoke scripts under scripts/ (they
# parse this file directly — see scripts/login-debug.mjs). Not read by the app,
# and not needed unless you run those scripts. Use a throwaway account: these
# are a real login, so whatever you put here can read that account's projects.
email=
password=
