# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
# `.tanstack/**` here would only ever match the repo root: a pattern with a
# slash in the middle is anchored to the directory holding the .gitignore, so
# apps/web/.tanstack/tmp/ slipped through and got committed. A trailing slash
# alone matches a directory of that name at any depth.
.tanstack/
.nitro
*.local

# Vercel
.vercel/

# Env files - real values live in Vercel/Railway dashboards, not git
.env
.env.local
apps/api/.env
apps/api/.env.local

# Local-only project docs - not committed
/docs/

# Throwaway files from local probing/debugging scripts. These have already once
# been left in the repo root holding a live Supabase access + refresh token, so
# ignore the whole shape rather than relying on remembering to delete them.
/scratch_*
/artifacts/
*.tok
*.token

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/CLAUDE.md
.claude/
/LAUNCH.md

# Supabase CLI scratch state (the linked project ref, cached CLI version).
supabase/.temp/

# Running an EAS command from the repo root instead of apps/mobile makes the CLI
# generate a blank eas.json here, which has none of the real profiles and
# silently shadows the intended config. It has been committed by accident once.
# Anchored with a leading slash so apps/mobile/eas.json, the real one, is
# unaffected.
/eas.json

# Apple Sign in with Apple signing keys - downloadable once, never in git
*.p8
AuthKey_*.p8

# Screenshots taken while checking the mobile app on a device.
.mobile-shots/
/docs

# Generated by `expo prebuild`. This is a CNG project: app.json, app.config.js
# and the config plugins are the source of truth, and these directories are
# rebuilt from them on demand. Committing them switches the project to the bare
# workflow, where every future prebuild change has to be reconciled by hand.
apps/mobile/android/
apps/mobile/ios/

# Android signing. The upload key is the one credential that cannot be rotated:
# lose it and this app can never be updated again, leak it and somebody else can
# publish as you. It belongs outside the repo entirely, and these patterns are a
# backstop rather than a place to keep it. `debug.keystore` is generated by
# prebuild and is public by design, but it lives under the ignored android/.
*.keystore
*.jks
keystore.properties
