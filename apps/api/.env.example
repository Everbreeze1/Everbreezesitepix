# Copy to apps/api/.env for local dev. Never commit the real file (see ../../.gitignore).
# Full description of each value: ../../docs/ops.md
# In production (Railway) these are set in the Railway service's Variables tab,
# not read from this file.

PORT=8787

# Comma-separated list of origins allowed to call this API (the web app's origin(s)).
# Leave unset to allow all origins (fine for local dev only).
# Local dev: http://localhost:8080
# Production (Railway Variables tab): https://everbreezesitepix.com
ALLOWED_ORIGINS=http://localhost:8080

# --- Required ---
SITEPIX_SUPABASE_URL=
SITEPIX_SUPABASE_PUBLISHABLE_KEY=
SITEPIX_SUPABASE_SERVICE_ROLE_KEY=
AUTH_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
# e.g. Everbreeze SitePix <info@your-verified-domain.com>
EMAIL_FROM=
# Optional; omit if replies should go to EMAIL_FROM
EMAIL_REPLY_TO=

# --- Required for AI / geocoding / walkthrough audio ---
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_API_KEY=

# --- Rate limits (optional, defaults shown) ---
RPC_RATE_LIMIT=120
RPC_RATE_WINDOW_MS=60000
EMAIL_RATE_LIMIT=10
EMAIL_RATE_WINDOW_MS=3600000
