# Copy to apps/api/.env for local dev. Never commit the real file (see ../../.gitignore).
# Full description of each value: ../../docs/ops.md
# In production (Railway) these are set in the Railway service's Variables tab,
# not read from this file.
#
# "Required" below means literally required: apps/api/src/server.ts keeps a
# REQUIRED_ENV list and refuses to boot if any of them is empty. Everything
# marked optional degrades a single feature instead.

# Optional - defaults to 8787. Railway injects its own PORT.
PORT=8787

# Optional but effectively required in production. Comma-separated list of
# origins allowed to call this API (the web app's origin(s)).
# Leave unset to allow all origins (fine for local dev only).
# Local dev: http://localhost:8080
# Production (Railway Variables tab): include BOTH the apex and www - Vercel
# redirects everbreezesitepix.com -> www.everbreezesitepix.com, so the browser's
# actual Origin header is the www one. Omitting it here = CORS silently blocks
# every API call from the live site.
# https://everbreezesitepix.com,https://www.everbreezesitepix.com
ALLOWED_ORIGINS=http://localhost:8080

# --- Required ---
SITEPIX_SUPABASE_URL=
SITEPIX_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS. Server-side only - never expose this to the browser.
SITEPIX_SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for the Supabase "Send Email" auth hook -> /v1/auth/send-email.
# Supabase generates it when you configure the hook (format: v1,whsec_...).
AUTH_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
# e.g. Everbreeze SitePix <team@your-verified-domain.com>
# Use a transactional local part - team@, notifications@. NOT info@/news@/hello@:
# role addresses like those are a strong bulk-mail cue and land our invites and
# password resets in Gmail's Promotions tab. Resend verifies the domain, not the
# mailbox, so any local part on the verified domain works with no extra setup.
# See ../../docs/ops.md § "Staying out of Gmail's Promotions tab".
EMAIL_FROM=
# Optional; omit if replies should go to EMAIL_FROM. Team invites ignore this and
# reply to the teammate who sent them (domains/email/team-invite.ts).
EMAIL_REPLY_TO=

# --- Optional; each one gates a single feature (the API boots without them) ---
# Photo + walkthrough AI analysis.
GEMINI_API_KEY=
# Server-side geocoding. Separate from the browser key in ../../.env.example:
# this one is IP-restricted, that one is HTTP-referrer restricted.
GOOGLE_MAPS_API_KEY=
# Walkthrough text-to-speech (Google Cloud TTS). Nothing reaches it today - the
# synthesizeBreezeSpeech RPC has no caller - so leaving it blank changes nothing
# and the boot check stays quiet about it. Speech-to-text uses GEMINI_API_KEY.
GOOGLE_CLOUD_API_KEY=
# Set to 1/true to re-enable the archive-old-photos cron. Off by default: it
# downscales old originals through Storage's render/image endpoint, which is
# metered per distinct origin image (100/cycle on Pro) - so it burns the quota
# the org is already over to reclaim storage that is 0.01% used. Turn it on when
# storage is the actual constraint.
PHOTO_ARCHIVE_ENABLED=

# --- Required for billing (Stripe) ---
STRIPE_SECRET_KEY=
# Signing secret for the /v1/billing/webhook endpoint (Stripe CLI `stripe listen`
# prints one for local dev; the dashboard gives you one per production endpoint).
STRIPE_WEBHOOK_SECRET=
# Monthly recurring price IDs from the Stripe dashboard (Products > Pricing).
# Required - checkout throws "Missing STRIPE_PRICE_<PLAN>" without them.
# These must be *graduated tiered* Prices; see the comment on planToPriceId in
# src/lib/stripe.ts for why a flat per-unit Price overcharges.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Annual price IDs. Required only once a customer picks annual billing - until
# they are set, annual checkout fails with "Missing STRIPE_PRICE_<PLAN>_ANNUAL".
# The live apps/api/.env already defines these; they were missing from this file.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_ANNUAL=
# Optional aliases. planToPriceId reads STRIPE_PRICE_<PLAN>_MONTHLY first and
# falls back to the unsuffixed var above, so these only exist for installs that
# want the interval spelled out. Leave unset unless you need them.
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_TEAM_MONTHLY=

# --- Rate limits (optional, defaults shown) ---
RPC_RATE_LIMIT=120
RPC_RATE_WINDOW_MS=60000
EMAIL_RATE_LIMIT=10
EMAIL_RATE_WINDOW_MS=3600000
