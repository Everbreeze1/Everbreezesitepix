# Everlumen mobile (Expo)
EXPO_PUBLIC_EVERLUMEN_SUPABASE_URL=https://ulmgvtuqjlzzadlwtiog.supabase.co
EXPO_PUBLIC_EVERLUMEN_SUPABASE_PUBLISHABLE_KEY=

# API host serving /v1 (empty = same host as web once configured; use full origin for device testing)
EXPO_PUBLIC_API_BASE_URL=https://everlumen.co

# Google Maps Android key, for the project map screen.
#
# Build-time, not runtime: react-native-maps renders through Google Maps on
# Android and bakes this into AndroidManifest.xml when the native project is
# generated. iOS uses Apple Maps and needs nothing. Without it the map is a grey
# rectangle with no error, so the map screen checks and says so instead.
#
# Restrict the key to com.everlumen.app and the Maps SDK for Android in the
# Google Cloud console. Every Android app drawing a Google map ships one and it
# is readable from any APK; the restriction is the control, not secrecy.
#
# For EAS builds set it as a project secret of this exact name
# (`eas env:create`), NOT in eas.json: that file rejects an empty env value, so
# declaring it there with no key would break every build until somebody had one.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
