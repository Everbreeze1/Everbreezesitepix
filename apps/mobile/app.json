{
  "expo": {
    "name": "Everlumen",
    "slug": "everlumen",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "everlumen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#171B24",
          "dark": {
            "backgroundColor": "#171B24"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Everlumen uses the camera to attach job-site photos to your projects.",
          "microphonePermission": "Everlumen uses the microphone to record voice notes during walkthroughs.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Everlumen uses your photo library so you can add existing job-site photos to a project."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Everlumen records where a photo was taken so it can be placed on the project map.",
          "locationWhenInUsePermission": "Everlumen records where a photo was taken so it can be placed on the project map.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "apiBaseUrl": "",
      "eas": {
        "projectId": "replace-me"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.everlumen.app"
    },
    "android": {
      "package": "com.everlumen.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171B24"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
