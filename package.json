{
  "name": "everlumen",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @everlumen/web",
    "build": "npm run build -w @everlumen/web",
    "build:dev": "npm run build:dev -w @everlumen/web",
    "preview": "npm run preview -w @everlumen/web",
    "deploy": "npm run deploy -w @everlumen/web",
    "lint": "eslint .",
    "lint:mobile": "eslint --config eslint.mobile.config.js apps/mobile/app apps/mobile/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "test:ssr:share": "node scripts/ssr-share-test.mjs",
    "test:ssr": "npm run build && node scripts/ssr-share-test.mjs",
    "typecheck:api": "npm run typecheck -w @everlumen/api",
    "mobile": "npm --prefix apps/mobile start",
    "mobile:build": "npm --prefix apps/mobile run build:dev",
    "mobile:build:preview": "npm --prefix apps/mobile run build:preview",
    "mobile:build:prod": "npm --prefix apps/mobile run build:prod",
    "mobile:shot": "bash scripts/mobile-screen.sh shot",
    "mobile:doctor": "bash scripts/mobile-screen.sh doctor",
    "mobile:metro": "bash scripts/mobile-screen.sh metro",
    "mobile:reload": "bash scripts/mobile-screen.sh reload",
    "mobile:env": "bash scripts/mobile-screen.sh env"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "supabase": "^2.115.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  }
}
